{
  "manifest_version": 3,
  "name": "AdSkip for Deezer",
  "version": "0.1.0",
  "description": "Skips the ads that podcast hosts insert into episodes played on deezer.com. No server, no tracking.",
  "homepage_url": "https://github.com/Babuh/adskip-for-deezer",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "webRequest"],
  "host_permissions": ["https://www.deezer.com/*", "*://*.audiomeans.fr/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "AdSkip for Deezer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.deezer.com/*"],
      "js": [
        "lib/timing.js",
        "lib/skipper.js",
        "lib/hosts.js",
        "hosts/audiomeans.js",
        "content/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.deezer.com/*"],
      "js": ["lib/settings.js", "content/bridge.js"],
      "run_at": "document_start"
    }
  ],
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "adskip-for-deezer@babuh.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
